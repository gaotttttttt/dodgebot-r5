{
	DodgeBotUI_SetLabel( "TitleLabel", DodgeBotUI_T( "DodgeBot 躲子弹靶子", "DodgeBot" ) )
	DodgeBotUI_SetLabel( "TitleSubLabel", DodgeBotUI_T( "设置（改完立即生效）", "Settings (applied at once)" ) )
	DodgeBotUI_SetLabel( "SectionSpawnTitle", DodgeBotUI_T( "靶子与练习", "TARGETS AND PRACTICE" ) )
	DodgeBotUI_SetLabel( "SectionMoveTitle", DodgeBotUI_T( "躲避与移速", "DODGING AND SPEED" ) )
	DodgeBotUI_SetLabel( "SectionRespawnTitle", DodgeBotUI_T( "击杀后刷新", "RESPAWN AFTER A KILL" ) )
	DodgeBotUI_SetLabel( "SectionLegendTitle", DodgeBotUI_T( "传奇靶子", "LEGEND BOTS" ) )
	DodgeBotUI_SetLabel( "SectionRealTitle", DodgeBotUI_T( "真人对战（只对传奇身体）", "REAL FIGHT (LEGEND BODY ONLY)" ) )
	DodgeBotUI_SetLabel( "FooterCloseLabel", DodgeBotUI_T( "关闭", "Close" ) )
	DodgeBotUI_SetLabel( "ResetLabel", DodgeBotUI_T( "恢复默认", "Reset all" ) )
	DodgeBotUI_SetLabel( "StatusLabel", "" )
	DodgeBotUI_RowText( "SpawnCount", DodgeBotUI_T( "移动靶数量", "Strafing targets" ), DodgeBotUI_T( "传奇身体，和你同一个传奇；点 < > 增减，最多 6 个", "Legend bodies, your legend; click < > to remove or add, up to 6" ), [] )
	DodgeBotUI_RowText( "God", DodgeBotUI_T( "无敌", "God mode" ), DodgeBotUI_T( "血量不会低于 5；换图后自动重新打开", "Health never drops below 5; set again after every map load" ), [ DodgeBotUI_T( "关", "Off" ), DodgeBotUI_T( "开", "On" ) ] )
	DodgeBotUI_RowText( "Armor", DodgeBotUI_T( "靶子护甲", "Target armor" ), DodgeBotUI_T( "假人和传奇靶子都生效；换图后自动重新设置", "Dummies and legend bots; set again after every map load" ), [ DodgeBotUI_T( "白", "White" ), DodgeBotUI_T( "蓝", "Blue" ), DodgeBotUI_T( "紫", "Purple" ), DodgeBotUI_T( "红", "Red" ), DodgeBotUI_T( "随机", "Random" ) ] )
	DodgeBotUI_RowText( "Level", DodgeBotUI_T( "难度", "Difficulty" ), DodgeBotUI_T( "反应速度和骗招比例", "Reaction time and share of bait strafes" ), [ DodgeBotUI_T( "关闭", "Off" ), DodgeBotUI_T( "休闲", "Casual" ), DodgeBotUI_T( "排位", "Ranked" ), DodgeBotUI_T( "职业", "Pro" ) ] )
	DodgeBotUI_RowText( "SpeedPreset", DodgeBotUI_T( "移速挡位", "Speed preset" ), DodgeBotUI_T( "跟随 Lab 扫射速度滑块，或固定 Apex 移速", "Follow the Lab strafe slider, or a fixed Apex speed" ), [ DodgeBotUI_T( "跟随滑块", "Lab slider" ), DodgeBotUI_T( "空手 199", "Unarmed 199" ), DodgeBotUI_T( "腰射 173", "Hipfire 173" ), DodgeBotUI_T( "开镜 130", "ADS 130" ) ] )
	DodgeBotUI_RowText( "CustomSpeed", DodgeBotUI_T( "自定义移速", "Custom speed" ), DodgeBotUI_T( "点 < > 改用这个速度（u/s）", "Click < > to use a custom speed (u/s)" ), [] )
	DodgeBotUI_RowText( "Respawn", DodgeBotUI_T( "360° 随机刷新", "360 deg respawn" ), DodgeBotUI_T( "击杀后刷在你周围，练找人", "New bots spawn around you in any direction" ), [ DodgeBotUI_T( "关", "Off" ), DodgeBotUI_T( "开", "On" ) ] )
	DodgeBotUI_RowText( "RespawnMin", DodgeBotUI_T( "最近距离", "Nearest" ), DodgeBotUI_T( "米", "Meters" ), [] )
	DodgeBotUI_RowText( "RespawnMax", DodgeBotUI_T( "最远距离", "Farthest" ), DodgeBotUI_T( "米", "Meters" ), [] )
	DodgeBotUI_RowText( "Fire", DodgeBotUI_T( "还手", "Shoot back" ), DodgeBotUI_T( "传奇身体的靶子会开枪打你", "Legend body bots fire at you" ), [ DodgeBotUI_T( "关", "Off" ), DodgeBotUI_T( "开", "On" ) ] )
	DodgeBotUI_RowText( "Ads", DodgeBotUI_T( "开镜", "ADS" ), DodgeBotUI_T( "自动：10 米外开镜，10 米内腰射", "Auto: ADS beyond 10 m, hipfire within 10 m" ), [ DodgeBotUI_T( "腰射", "Hipfire" ), DodgeBotUI_T( "自动", "Auto" ), DodgeBotUI_T( "一直开镜", "Always ADS" ) ] )
	DodgeBotUI_RowText( "Aim", DodgeBotUI_T( "枪法", "Aim" ), DodgeBotUI_T( "0 乱喷、跟枪慢，100 很准", "0 = worst, 100 = best" ), [] )
	DodgeBotUI_RowText( "RealFight", DodgeBotUI_T( "真人对战", "Real fight" ), DodgeBotUI_T( "会找掩体、滑铲跳、找你；关掉就是原来的躲子弹", "Uses cover, slide jumps and hunts you; off = plain dodging" ), [ DodgeBotUI_T( "关", "Off" ), DodgeBotUI_T( "开", "On" ) ] )
	DodgeBotUI_RowText( "RealCover", DodgeBotUI_T( "掩体", "Cover" ), DodgeBotUI_T( "积极：刚挨打也会考虑躲", "Often: may also hide right after being hit" ), [ DodgeBotUI_T( "不用", "Never" ), DodgeBotUI_T( "残血换弹", "Hurt/reload" ), DodgeBotUI_T( "积极", "Often" ) ] )
	DodgeBotUI_RowText( "RealSlide", DodgeBotUI_T( "滑铲跳", "Slide jump" ), DodgeBotUI_T( "冲刺、滑铲、起跳换位置", "Sprint, slide and jump to reposition" ), [ DodgeBotUI_T( "关", "Off" ), DodgeBotUI_T( "开", "On" ) ] )
	// The button names the language it switches to.
	DodgeBotUI_SetLabel( "LangLabel", DodgeBotUI_T( "English", "中文" ) )
}

void function DodgeBotUI_RowText( string name, string title, string hint, array<string> labels )
{
	DodgeBotUI_SetLabel( name + "Text", title )
	DodgeBotUI_SetLabel( name + "Hint", hint )
	for ( int i = 0; i < labels.len(); i++ )
		DodgeBotUI_SetLabel( format( "%sSegText%d", name, i ), labels[i] )
}

string function DodgeBotUI_T( string zh, string en )
{
	return file.chinese ? zh : en
}

// The saved choice, else the language the game runs in.
void function DodgeBotUI_LoadLang()
{
	string saved = ""
	try
	{
		saved = strip( LocalStore_Read( DODGEBOTUI_STORE ) )
	}
	catch ( eRead )
	{
	}
	if ( saved == "zh" || saved == "en" )
	{
		file.chinese = saved == "zh"
		return
	}
	string game = GetLanguage()
	file.chinese = game == "schinese" || game == "tchinese"
}

void function DodgeBotUI_OnLangClick( var button )
{
	file.chinese = !file.chinese
	try
	{
		LocalStore_Write( DODGEBOTUI_STORE, file.chinese ? "zh" : "en" )
	}
	catch ( eWrite )
	{
		printt( format( "[DODGEBOTUI] language not saved: %s", string( eWrite ) ) )
	}
	DodgeBotUI_SendLang()
	DodgeBotUI_ApplyLang()
	DodgeBotUI_Refresh()
}

// Language of the DodgeBot messages on screen.
void function DodgeBotUI_SendLang()
{
	if ( IsFullyConnected() )
		ClientCommand( file.chinese ? "dodgebot lang zh" : "dodgebot lang en" )
}

void function DodgeBotUI_SetLabel( string name, string text )
{
	Hud_SetText( Hud_GetChild( file.menu, name ), text )
}

void function DodgeBotUI_AddOption( string name, int count )
{
	DodgeBotUIOption row
	row.name = name
	row.count = count
	file.options.append( row )

	for ( int i = 0; i < count; i++ )
	{
		int pick = i
		Hud_AddEventHandler( Hud_GetChild( file.menu, format( "%sSeg%d", name, i ) ), UIE_CLICK,
			void function( var button ) : ( name, pick )
			{
				DodgeBotUI_OnOption( name, pick )
			}
		)
	}
}

void function DodgeBotUI_AddStepper( string name, int minValue, int maxValue, int step, string suffix )
{
	DodgeBotUIStepper row
	row.name = name
	row.minValue = minValue
	row.maxValue = maxValue
	row.step = step
	row.suffix = suffix
	file.steppers.append( row )

	Hud_AddEventHandler( Hud_GetChild( file.menu, name + "Dec" ), UIE_CLICK,
		void function( var button ) : ( row )
		{
			DodgeBotUI_OnStep( row, -1 )
		}
	)
	Hud_AddEventHandler( Hud_GetChild( file.menu, name + "Inc" ), UIE_CLICK,
		void function( var button ) : ( row )
		{
			DodgeBotUI_OnStep( row, 1 )
		}
	)
}

// ---- Open / close -------------------------------------------------------------

void function DodgeBotUI_Open()
{
	if ( file.menu == null )
	{
		printt( "[DODGEBOTUI] Open: menu was not built (layout file missing?)" )
		return
	}
	CloseAllMenus()
	EmitUISound( "UI_Menu_FriendInspect" )
	AdvanceMenu( file.menu )
}

void function DodgeBotUI_OnOpen()
{
	DodgeBotUI_Refresh()
}

void function DodgeBotUI_OnBack()
{
	CloseAllMenus()
}

void function DodgeBotUI_OnCloseClick( var button )
{
	CloseAllMenus()
}

void function DodgeBotUI_OnResetClick( var button )
{
	file.level = 2
	file.speedMode = DODGEBOTUI_SPEED_OFF
	file.customSpeed = 160
	file.respawnOn = true
	file.respawnMin = 10
	file.respawnMax = 17
	file.fireOn = true
	file.ads = 1
	file.aim = 50
	file.realFight = 0
	file.realCover = 1
	file.realSlide = 1
	file.changed = true
	DodgeBotUI_SendAll()
	DodgeBotUI_Refresh()
}

// ---- Changes ------------------------------------------------------------------

void function DodgeBotUI_OnOption( string name, int pick )
{
	if ( name == "Armor" )
	{
		file.armor = pick
		DodgeBotUI_SendArmor()
		DodgeBotUI_Refresh()
		return
	}
	if ( name == "God" )
	{
		file.god = pick
		DodgeBotUI_SendGod()
		DodgeBotUI_Refresh()
		return
	}
	switch ( name )
	{
		case "Level":
			file.level = pick
			DodgeBotUI_SendLevel()
			break
		case "SpeedPreset":
			file.speedMode = pick
			DodgeBotUI_SendSpeed()
			break
		case "Respawn":
			file.respawnOn = pick == 1
			DodgeBotUI_SendRespawn()
			break
		case "Fire":
			file.fireOn = pick == 1
			DodgeBotUI_SendFire()
			break
		case "Ads":
			file.ads = pick
			DodgeBotUI_SendAds()
			break
		case "RealFight":
			file.realFight = pick
			DodgeBotUI_SendReal()
			break
		case "RealCover":
			file.realCover = pick
			DodgeBotUI_SendReal()
			break
		case "RealSlide":
			file.realSlide = pick
			DodgeBotUI_SendReal()
			break
	}
	file.changed = true
	DodgeBotUI_Refresh()
}

void function DodgeBotUI_OnStep( DodgeBotUIStepper row, int dir )
{
	if ( row.name == "SpawnCount" )
	{
		DodgeBotUI_StepSpawn( dir )
		return
	}
	int value = DodgeBotUI_StepperValue( row.name ) + dir * row.step
	value = maxint( row.minValue, minint( row.maxValue, value ) )
	switch ( row.name )
	{
		case "CustomSpeed":
			file.customSpeed = value
			file.speedMode = DODGEBOTUI_SPEED_CUSTOM
			DodgeBotUI_SendSpeed()
			break
		case "RespawnMin":
			file.respawnMin = value
			if ( file.respawnMax < value )
				file.respawnMax = value
			if ( file.respawnOn )
				DodgeBotUI_SendRespawn()
			break
		case "RespawnMax":
			file.respawnMax = value
			if ( file.respawnMin > value )
				file.respawnMin = value
			if ( file.respawnOn )
				DodgeBotUI_SendRespawn()
			break
		case "Aim":
			file.aim = value
			DodgeBotUI_SendAim()
			break
	}
	file.changed = true
	DodgeBotUI_Refresh()
}

// Remove always asks the Lab, so a count that drifted from the Lab can be brought down.
void function DodgeBotUI_StepSpawn( int dir )
{
	if ( dir > 0 )
	{
		if ( file.spawnCount >= DODGEBOTUI_SPAWN_MAX )
			return
		file.spawnCount++
		DodgeBotUI_SendBody()
		DodgeBotUI_Send( "dev_aimtrainer strafer_add" )
	}
	else
	{
		file.spawnCount = maxint( 0, file.spawnCount - 1 )
		DodgeBotUI_Send( "dev_aimtrainer strafer_remove" )
	}
	DodgeBotUI_Refresh()
}

// Lab armor setting: 1-4 white-red, 10 random. It re-tiers live dummies and
// legend bots, and new ones spawn with it.
void function DodgeBotUI_SendArmor()
{
	if ( file.armor < 0 )
		return
	array<int> codes = [ 1, 2, 3, 4, 10 ]
	DodgeBotUI_Send( "dev_aimtrainer armor " + codes[ minint( file.armor, 4 ) ] )
}

// An explicit on/off: a bare "demigod" only flips whatever the server has.
void function DodgeBotUI_SendGod()
{
	if ( file.god >= 0 )
		DodgeBotUI_Send( file.god == 1 ? "demigod 1" : "demigod 0" )
}

// Targets from here are always legend bodies, same legend as you.
void function DodgeBotUI_SendBody()
{
	DodgeBotUI_Send( "dev_aimtrainer strafer_body legend" )
	DodgeBotUI_Send( "dev_aimtrainer strafer_legend same" )
}

int function DodgeBotUI_StepperValue( string name )
{
	switch ( name )
	{
		case "SpawnCount":
			return file.spawnCount
		case "CustomSpeed":
			return file.customSpeed
		case "RespawnMin":
			return file.respawnMin
		case "RespawnMax":
			return file.respawnMax
		case "Aim":
			return file.aim
	}
	return 0
}

int function DodgeBotUI_OptionValue( string name )
{
	switch ( name )
	{
		case "God":
			return file.god
		case "Armor":
			return file.armor
		case "Level":
			return file.level
		case "SpeedPreset":
			return file.speedMode   // custom (4) lights no segment
		case "Respawn":
			return file.respawnOn ? 1 : 0
		case "Fire":
			return file.fireOn ? 1 : 0
		case "Ads":
			return file.ads
		case "RealFight":
			return file.realFight
		case "RealCover":
			return file.realCover
		case "RealSlide":
			return file.realSlide
	}
	return -1
}

// ---- Commands to the DodgeBot mod -----------------------------------------------

void function DodgeBotUI_Send( string cmd )
{
	if ( !IsFullyConnected() )
		return
	ClientCommand( cmd )
	file.lastSent = cmd
	printt( "[DODGEBOTUI] sent: " + cmd )
}

void function DodgeBotUI_SendLevel()
{
	DodgeBotUI_Send( format( "dodgebot %d", file.level ) )
}

void function DodgeBotUI_SendSpeed()
{
	switch ( file.speedMode )
	{
		case DODGEBOTUI_SPEED_UNARMED:
			DodgeBotUI_Send( "dodgebot speed unarmed" )
			return
		case DODGEBOTUI_SPEED_HIPFIRE:
			DodgeBotUI_Send( "dodgebot speed hipfire" )
			return
		case DODGEBOTUI_SPEED_ADS:
			DodgeBotUI_Send( "dodgebot speed ads" )
			return
		case DODGEBOTUI_SPEED_CUSTOM:
			DodgeBotUI_Send( format( "dodgebot speed %d", file.customSpeed ) )
			return
	}
	DodgeBotUI_Send( "dodgebot speed off" )
}

void function DodgeBotUI_SendRespawn()
{
	if ( file.respawnOn )
		DodgeBotUI_Send( format( "dodgebot respawn %d %d", file.respawnMin, file.respawnMax ) )
	else
		DodgeBotUI_Send( "dodgebot respawn off" )
}

void function DodgeBotUI_SendFire()
{
	DodgeBotUI_Send( file.fireOn ? "dodgebot fire on" : "dodgebot fire off" )
}

void function DodgeBotUI_SendAds()
{
	DodgeBotUI_Send( format( "dodgebot ads %d", file.ads ) )
}

void function DodgeBotUI_SendReal()
{
	DodgeBotUI_Send( format( "realfight cover %d", file.realCover ) )
	DodgeBotUI_Send( format( "realfight slide %d", file.realSlide ) )
	DodgeBotUI_Send( format( "realfight %d", file.realFight ) )
}

void function DodgeBotUI_SendAim()
{
	DodgeBotUI_Send( format( "dodgebot aim %d", file.aim ) )
}

void function DodgeBotUI_SendAll()
{
	DodgeBotUI_SendLevel()
	DodgeBotUI_SendSpeed()
	DodgeBotUI_SendRespawn()
	DodgeBotUI_SendFire()
	DodgeBotUI_SendAds()
	DodgeBotUI_SendReal()
	DodgeBotUI_SendAim()
}

// After a level load (from the client script): the new server starts from the
// DodgeBot defaults, so put back what was set in this session.
void function DodgeBotUI_PushSaved()
{
	DodgeBotUI_SendLang()
	file.spawnCount = 0   // a new map starts with no strafers
	DodgeBotUI_SendGod()   // the server forgets it on every load
	DodgeBotUI_SendArmor()
	if ( !file.changed )
		return
	printt( "[DODGEBOTUI] level loaded, resending saved settings" )
	DodgeBotUI_SendAll()
}

// ---- Drawing ------------------------------------------------------------------

void function DodgeBotUI_Refresh()
{
	if ( file.menu == null )
		return

	foreach ( DodgeBotUIOption row in file.options )
	{
		int value = DodgeBotUI_OptionValue( row.name )
		for ( int i = 0; i < row.count; i++ )
		{
			bool on = i == value
			Hud_SetVisible( Hud_GetChild( file.menu, format( "%sSegFill%d", row.name, i ) ), on )
			var text = Hud_GetChild( file.menu, format( "%sSegText%d", row.name, i ) )
			if ( on )
				Hud_SetColor( text, 6, 20, 13, 255 )
			else
				Hud_SetColor( text, 169, 184, 175, 255 )
		}
	}

	foreach ( DodgeBotUIStepper row in file.steppers )
	{
		int value = DodgeBotUI_StepperValue( row.name )
		var valueLabel = Hud_GetChild( file.menu, row.name + "Value" )
		Hud_SetText( valueLabel, format( "%d%s", value, row.suffix ) )
		bool active = DodgeBotUI_StepperActive( row.name )
		if ( active )
			Hud_SetColor( valueLabel, 61, 218, 138, 255 )
		else
			Hud_SetColor( valueLabel, 122, 134, 127, 255 )

		float span = float( row.maxValue - row.minValue )
		int fillW = int( DODGEBOTUI_FILL_W * ( float( value - row.minValue ) / span ) )
		var fill = Hud_GetChild( file.menu, row.name + "Fill" )
		Hud_SetWidth( fill, fillW )
		Hud_SetVisible( fill, fillW > 0 && active )
	}

	string status = IsFullyConnected() ? "" : DodgeBotUI_T( "没在游戏里：改动会在进图后发送", "Not in a game: changes are sent when you load in" )
	if ( status == "" && file.lastSent != "" )
		status = DodgeBotUI_T( "已发送: ", "Sent: " ) + file.lastSent
	DodgeBotUI_SetLabel( "StatusLabel", status )
}

// Greyed out when the value is not in use right now.
bool function DodgeBotUI_StepperActive( string name )
{
	switch ( name )
	{
		case "CustomSpeed":
			return file.speedMode == DODGEBOTUI_SPEED_CUSTOM
		case "RespawnMin":
		case "RespawnMax":
			return file.respawnOn
		case "Aim":
			return file.fireOn
	}
	return true
}
