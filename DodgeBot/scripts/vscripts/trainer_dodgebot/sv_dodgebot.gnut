const float DODGE_STUCK_DIST_SQR = 36.0       // < 6u per 0.1 s = against a wall
const int DODGE_STUCK_CHECKS_NEEDED = 2
const float DODGE_LEASH = 320.0               // max wander from the spawn spot
const float DODGE_CHEST = 48.0
const float DODGE_SHOT_NEAR = 80.0            // a round passing within this is "shot at"
const float DODGE_SHOT_MEMORY = 0.15
const float DODGE_HURT_MEMORY = 0.15
const float DODGE_ENGAGED_HOLD = 1.6          // stays in fight mode this long after a threat
const float DODGE_CLOSING_SPEED = 60.0        // crosshair closing faster than this = being tracked
const float DODGE_FACE_EPS = 6.0
const float DODGE_RANGE_YAW = 28.0            // yaw bend that turns a strafe into a diagonal
const float DODGE_CLOSE_RANGE = 350.0
const float DODGE_FAR_RANGE = 1500.0
const int DODGE_DEFAULT_LEVEL = 2
// Speed presets (units/s): Apex move speed by what the player holds.
